{
  "name": "@destyler/designs-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Fixed shadcn reference and real Destyler React, Vue, Solid and Svelte style adapters",
  "scripts": {
    "start": "npm run dev",
    "test": "node --test test/*.test.mjs",
    "test:http": "node scripts/smoke-http.mjs",
    "check": "node scripts/check.mjs",
    "dev": "npm run build:all-components:sources && npm run build:designs && npm run build:consumers && npm run build:css-consumers && npm run build:all-components:frames && astro dev --host 127.0.0.1",
    "start:legacy": "node scripts/serve.mjs",
    "build": "npm run build:all-components:sources && npm run build:designs && node scripts/copy-notices.mjs && astro build && vite build && npm run build:consumers && npm run build:css-consumers && npm run build:all-components:frames",
    "preview": "astro preview --host 127.0.0.1",
    "check:types": "vue-tsc --noEmit && tsc --noEmit -p examples/vanilla-extract/solid/tsconfig.json && svelte-check --tsconfig ./examples/vanilla-extract/svelte/tsconfig.json",
    "sync:shadcn": "node scripts/extract-shadcn-recipes.mjs",
    "test:browser": "node scripts/test-shadcn-browser.mjs",
    "test:dom": "node scripts/smoke-shadcn-dom.mjs && node scripts/test-showcase-dom.mjs",
    "build:designs": "node scripts/build-vanilla-extract.mjs",
    "build:consumers": "node scripts/vanilla-extract-consumers.mjs build all",
    "test:designs": "node scripts/verify-vanilla-extract.mjs",
    "test:designs:browser": "node scripts/test-vanilla-extract-browser.mjs",
    "test:designs:panels": "node scripts/verify-vanilla-extract-panels.mjs",
    "check:astro": "astro check --tsconfig tsconfig.astro.json",
    "test:showcase:browser": "node scripts/test-astro-showcase-browser.mjs",
    "test:showcase:rendering": "node scripts/verify-showcase-rendering.mjs",
    "test:showcase:dom": "node scripts/test-astro-host-dom.mjs",
    "build:css-consumers": "node scripts/build-css-only-consumers.mjs build",
    "check:css-types": "vue-tsc --noEmit -p examples/css-only/tsconfig.json && tsc --noEmit -p examples/css-only/solid/tsconfig.json && svelte-check --tsconfig ./examples/css-only/svelte/tsconfig.json",
    "test:css": "node scripts/verify-css-only.mjs && node scripts/verify-css-only-ssr.mjs && node scripts/verify-css-only-unocss.mjs",
    "test:reference:browser": "node scripts/test-reference-browser.mjs",
    "build:all-components:sources": "node scripts/export-all-component-sources.mjs",
    "build:all-components:frames": "node scripts/build-all-components.mjs",
    "check:all-components": "tsc -p examples/all-components/tsconfig.json && tsc -p examples/all-components/react/tsconfig.json && vue-tsc --noEmit -p examples/all-components/vue/tsconfig.json && tsc -p examples/all-components/solid/tsconfig.json && svelte-check --tsconfig examples/all-components/svelte/tsconfig.json",
    "test:all-components:host": "node scripts/test-all-components-host.mjs",
    "test:all-components": "node scripts/verify-all-components.mjs"
  },
  "dependencies": {
    "@destyler-ui/react": "0.0.4",
    "@destyler-ui/solid": "0.0.4",
    "@destyler-ui/svelte": "0.0.4",
    "@destyler-ui/vue": "0.0.4",
    "@fontsource-variable/geist": "5.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "radix-ui": "1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "solid-js": "1.9.17",
    "svelte": "5.57.2",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/react": "4.4.2",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/node": "4.3.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/rollup-plugin": "1.5.4",
    "@vitejs/plugin-react": "5.0.4",
    "@vitejs/plugin-vue": "6.0.1",
    "@vue/server-renderer": "3.5.22",
    "astro": "5.18.2",
    "happy-dom": "21.0.4",
    "playwright": "1.56.1",
    "rollup-plugin-esbuild": "6.2.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "unocss": "66.12.0",
    "vite": "7.1.12",
    "vite-plugin-solid": "2.11.14",
    "vue-tsc": "3.1.1"
  }
}
