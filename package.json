{
  "name": "@destyler/designs-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Source-backed shadcn New York design adapters on real Destyler React and Vue primitives",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "test": "node --test test/*.test.mjs",
    "test:http": "node scripts/smoke-http.mjs",
    "check": "node scripts/check.mjs",
    "dev": "vite --host 127.0.0.1",
    "start:legacy": "node scripts/serve.mjs",
    "build": "node scripts/copy-notices.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:types": "vue-tsc --noEmit",
    "sync:shadcn": "node scripts/extract-shadcn-recipes.mjs",
    "test:browser": "node scripts/test-shadcn-browser.mjs",
    "test:dom": "node scripts/smoke-shadcn-dom.mjs"
  },
  "dependencies": {
    "@destyler-ui/react": "0.0.1-beta.21",
    "@destyler-ui/vue": "0.0.1-beta.21",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.67.0",
    "radix-ui": "1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "@vitejs/plugin-vue": "6.0.1",
    "happy-dom": "21.0.4",
    "playwright": "1.56.1",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vue-tsc": "3.1.1"
  }
}
