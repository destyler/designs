{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "cn": [
        "examples/shadcn/lib/utils.ts"
      ],
      "@/lib/utils": [
        "examples/shadcn/lib/utils.ts"
      ],
      "@/registry/new-york-v4/ui/*": [
        "vendor/shadcn/new-york-v4/ui/*"
      ],
      "@destyler/designs-vanilla-extract-poc": [
        "packages/vanilla-extract/dist/index.d.ts"
      ]
    },
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "examples/shadcn/**/*.ts",
    "examples/shadcn/**/*.tsx",
    "examples/shadcn/**/*.vue",
    "vendor/shadcn/**/*.tsx",
    "packages/vanilla-extract/src/**/*.ts",
    "examples/vanilla-extract/**/*.ts",
    "examples/vanilla-extract/**/*.tsx",
    "examples/vanilla-extract/**/*.vue"
  ],
  "exclude": [
    "examples/vanilla-extract/solid"
  ]
}
