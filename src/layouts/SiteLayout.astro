---
import '@fontsource-variable/geist'
import '../../examples/shadcn/styles/app.css'
import '../../examples/showcase/showcase.css'
const { title = 'Switch · Destyler designs' } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0c0e" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Compare original shadcn/ui components with real Destyler React, Vue, Solid and Svelte implementations." />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
