---
import SiteLayout from '../layouts/SiteLayout.astro'
import Comparison from '../../examples/showcase/main'
import { ArrowUpRight, CodeXml, Layers3 } from 'lucide-react'
---
<SiteLayout>
  <div class="site-shell unified-showcase">
    <a href="#main-content" class="skip-link">Skip to comparison</a>
    <header class="site-header">
      <a href="/" class="wordmark" aria-label="Destyler designs home"><span class="brand-symbol" aria-hidden="true"><i></i><i></i><i></i></span><strong>destyler</strong><span class="wordmark-divider">/</span><span>designs</span></a><span class="header-status"><span></span>Component lab</span>
      <nav aria-label="Site navigation"><a href="https://ui.destyler.org/" class="header-label">UI documentation <ArrowUpRight size={13}/></a><a href="https://github.com/destyler/designs/tree/main" class="repository-link"><CodeXml size={16}/><span>GitHub</span><ArrowUpRight size={13}/></a></nav>
    </header>
    <div class="site-layout">
      <aside class="sidebar" aria-label="Component library">
        <div class="sidebar-section-label"><span>Explore components</span><span>02</span></div>
        <nav class="component-navigation" aria-label="Examples"><div class="nav-group"><a href="#switch" aria-current="page"><span class="nav-index" aria-hidden="true">01</span>Switch<span class="nav-arrow" aria-hidden="true">↗</span></a><a href="#dialog"><span class="nav-index" aria-hidden="true">02</span>Dialog<span class="nav-arrow" aria-hidden="true">↗</span></a></div></nav>
        <div class="sidebar-integrations"><p class="sidebar-section-label">Four frameworks</p><ul><li><span class="framework-dot" data-framework="react"></span>React</li><li><span class="framework-dot" data-framework="vue"></span>Vue</li><li><span class="framework-dot" data-framework="solid"></span>Solid</li><li><span class="framework-dot" data-framework="svelte"></span>Svelte</li></ul></div>
        <div class="sidebar-note"><Layers3 size={20}/><p>One design.<br/><strong>Every framework.</strong></p><span>shadcn/ui × Destyler</span></div>
      </aside>
      <main id="main-content" class="main-content" tabindex="-1">
        <Comparison client:load />
        <noscript><p class="noscript-note">Enable JavaScript to interact with the previews and switch frameworks.</p></noscript>
        <footer class="site-footer"><span><span class="footer-dot" aria-hidden="true"></span>Destyler designs <span class="footer-separator">/</span> An open experiment</span><a href="/THIRD_PARTY_NOTICES.txt">Licenses <ArrowUpRight size={12}/></a></footer>
      </main>
    </div>
  </div>
</SiteLayout>
<script>
  function updateNavigation() {
    const selected = location.hash === '#dialog' ? '#dialog' : '#switch'
    for (const link of document.querySelectorAll('nav[aria-label="Examples"] a')) {
      if (link.getAttribute('href') === selected) link.setAttribute('aria-current', 'page')
      else link.removeAttribute('aria-current')
    }
    document.title = `${selected === '#dialog' ? 'Dialog' : 'Switch'} · Destyler designs`
  }
  updateNavigation()
  window.addEventListener('hashchange', updateNavigation)
</script>
