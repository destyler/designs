---
import SiteLayout from '../layouts/SiteLayout.astro'
import Comparison from '../../examples/showcase/main'
import { ArrowUpRight, CodeXml } from 'lucide-react'
---
<SiteLayout>
  <div class="site-shell unified-showcase">
    <a href="#main-content" class="skip-link">Skip to comparison</a>
    <header class="site-header">
      <a href="/" class="wordmark"><strong>destyler</strong><span class="wordmark-divider">/</span><span>designs</span></a>
      <nav aria-label="Site navigation"><a href="https://ui.destyler.org/" class="header-label">UI documentation <ArrowUpRight size={13}/></a><a href="https://github.com/destyler/designs/tree/main" class="repository-link"><CodeXml size={16}/><span>GitHub</span><ArrowUpRight size={13}/></a></nav>
    </header>
    <div class="site-layout">
      <aside class="sidebar" aria-label="Component library">
        <nav class="component-navigation" aria-label="Examples"><div class="nav-group"><p>Components</p><a href="#switch" aria-current="page">Switch</a><a href="#dialog">Dialog</a></div></nav>
        <p class="sidebar-note">Styled with shadcn/ui.<br/>Built with Destyler UI.</p>
      </aside>
      <main id="main-content" class="main-content" tabindex="-1">
        <Comparison client:load />
        <noscript><p class="noscript-note">Enable JavaScript to interact with the previews and switch frameworks.</p></noscript>
        <footer class="site-footer"><span>destyler designs</span><a href="/THIRD_PARTY_NOTICES.txt">Licenses <ArrowUpRight size={12}/></a></footer>
      </main>
    </div>
  </div>
</SiteLayout>
<script>
  function updateNavigation() {
    const selected = location.hash === '#dialog' ? '#dialog' : '#switch'
    for (const link of document.querySelectorAll('nav[aria-label="Examples"] a')) {
      if (link.getAttribute('href') === selected) link.setAttribute('aria-current', 'page')
      else link.removeAttribute('aria-current')
    }
    document.title = `${selected === '#dialog' ? 'Dialog' : 'Switch'} · Destyler designs`
  }
  updateNavigation()
  window.addEventListener('hashchange', updateNavigation)
</script>
